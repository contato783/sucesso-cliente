# Banco de dados (SQLite para começar; em produção use Postgres:
# postgresql+psycopg://usuario:senha@host/sucesso_cliente)
DATABASE_URL=sqlite:///./sucesso_cliente.db

# Senha simples para proteger o painel e a API (obrigatório em produção)
PAINEL_TOKEN=troque-este-token

# --- Claude (análise de sentimento) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# --- WhatsApp ---
# Meta Cloud API: token de verificação que você define no painel da Meta
WHATSAPP_VERIFY_TOKEN=
# Segredo do app Meta, para validar a assinatura X-Hub-Signature-256 (opcional, recomendado)
WHATSAPP_APP_SECRET=
# Evolution API / Z-API: segredo enviado no header "apikey" ou "x-webhook-token"
WHATSAPP_WEBHOOK_SECRET=

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=

# --- Sponte ---
# Confirme URL e nomes dos métodos com o suporte do Sponte antes de ativar
SPONTE_BASE_URL=https://api.sponteeducacional.net.br/WSAPIEdu.asmx
SPONTE_CODIGO_CLIENTE=
SPONTE_TOKEN=
SPONTE_METODO_ALUNOS=GetAlunos
SPONTE_METODO_PARCELAS=GetParcelas

# --- Pesos do health score (somam 100) ---
PESO_ENGAJAMENTO=30
PESO_SENTIMENTO=25
PESO_FINANCEIRO=25
PESO_RESULTADO=20

# --- Metas das 10 leis do Customer Success ---
META_PRIMEIRO_VALOR_DIAS=30
META_TOQUE_DIAS=14

# --- Sincronização automática (minutos; 0 desliga) ---
SYNC_AUTOMATICO_MINUTOS=60
